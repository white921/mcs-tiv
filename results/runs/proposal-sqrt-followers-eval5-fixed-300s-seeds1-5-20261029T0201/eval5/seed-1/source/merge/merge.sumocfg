<configuration>
<input>
    <net-file value="threeLane.net.xml"/>
    <route-files value="threeLane.rou.xml"/>
    <collision.action value="none"/>
</input>
<output>
<fcd-output value="./statistics/sumoStat.xml"/>
<fcd-output.acceleration value="t"/>
</output>
<time>
    <step-length value="0.1"/>
    <time-to-teleport value="-1"/>
    <begin value="0.0"/>
    <end value="600.0"/>
</time>
</configuration>
