<configuration>
    <input>
        <net-file value="../net/ramp.net.xml"/>
        <route-files value="../routes/vehicles.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="60"/>
        <step-length value="0.1"/>
    </time>

    <output>
        <tripinfo-output value="../outputs/tripinfo.xml"/>
    </output>
</configuration>
